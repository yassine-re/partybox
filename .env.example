# Development only. Replace the password before deploying.
POSTGRES_DB=partybox
POSTGRES_USER=partybox
# Local database explorers connect to 127.0.0.1 on this port.
POSTGRES_PORT=5432
POSTGRES_PASSWORD=partybox_dev_only
DATABASE_URL=postgres://partybox:partybox_dev_only@postgres:5432/partybox?sslmode=disable
BACKEND_PORT=8080
FRONTEND_PORT=3000
FRONTEND_BIND=0.0.0.0
# With a tunnel, use its public HTTPS URL here without the local :3000 port.
FRONTEND_URL=http://localhost:3000
# Relative URL works on localhost AND phones on the same Wi-Fi.
PUBLIC_API_URL=/api
# Docker-internal address: keep this even when using a public frontend tunnel.
API_INTERNAL_URL=http://backend:8080
# Optional production Caddy profile:
DOMAIN=partybox.example.com
ACME_EMAIL=you@example.com

# Optional AI-powered mission generation (OpenAI Responses API / Structured Outputs)
OPENAI_API_KEY=
# Required with OPENAI_API_KEY. Choose a model supporting Responses + Structured Outputs.
OPENAI_MODEL=

# Optional Treasure Hunt photo validation. Explicit opt-in; no OPENAI_MODEL fallback.
OPENAI_VISION_MODEL=
OPENAI_VISION_DETAIL=low

# Mini-jeu physique ESP32 (aucun token device dans ce fichier)
REACTION_ENABLED=true
REACTION_MIN_INTERVAL_SECONDS=45
REACTION_MAX_INTERVAL_SECONDS=90
REACTION_ASSIGNMENT_TIMEOUT_SECONDS=45
REACTION_RESULT_TIMEOUT_SECONDS=15
DEVICE_ONLINE_TIMEOUT_SECONDS=10
