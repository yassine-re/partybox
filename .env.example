# Development only. Replace the password before deploying.
POSTGRES_DB=partybox
POSTGRES_USER=partybox
# Local database explorers connect to 127.0.0.1 on this port.
POSTGRES_PORT=5432
POSTGRES_PASSWORD=partybox_dev_only
DATABASE_URL=postgres://partybox:partybox_dev_only@postgres:5432/partybox?sslmode=disable
BACKEND_PORT=8080
FRONTEND_PORT=3000
FRONTEND_BIND=0.0.0.0
# With a tunnel, use its public HTTPS URL here without the local :3000 port.
FRONTEND_URL=http://localhost:3000
# Relative URL works on localhost AND phones on the same Wi-Fi.
PUBLIC_API_URL=/api
# Docker-internal address: keep this even when using a public frontend tunnel.
API_INTERNAL_URL=http://backend:8080
# Optional production Caddy profile:
DOMAIN=partybox.example.com
ACME_EMAIL=you@example.com
